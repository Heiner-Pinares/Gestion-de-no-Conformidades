# Copiar como .env en el servidor Windows. Los secretos van en archivos aparte.
SECRET_KEY_FILE=secrets/django_secret_key.txt
DEBUG=False
ALLOWED_HOSTS=172.19.194.219,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://172.19.194.219:8000
# Mientras el portal se publique directamente por HTTP en la IP interna.
# Cambiar estas tres variables a True al habilitar HTTPS en IIS/proxy.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_PRELOAD=False
# Activar solo si el proxy aprobado reemplaza y controla X-Forwarded-Proto.
TRUST_X_FORWARDED_PROTO=False

DB_ENGINE=oracle
DB_DSN="(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=scan-dwo.tim.com.pe)(PORT=1521))(CONNECT_DATA=(SERVER=DEDICATED)(SERVICE_NAME=DWO)))"
DB_SCHEMA=USRFACT
# Usar una sola cuenta de conexión con los GRANT del instalador.
DB_USER=USRFACSOP
DB_PASSWORD_FILE=secrets/oracle_password.txt
DB_REQUIRE_DML_ONLY=True
DB_ALLOWED_USERS=USRFACSOP
DB_CONN_MAX_AGE=60
# USRFACSOP conserva un verificador 10G; el modo Thick permite autenticarlo.
ORACLE_THICK_MODE=True
ORACLE_CLIENT_LIB_DIR=C:/oracle/instantclient_19

PORTAL_BIND_HOST=0.0.0.0
PORTAL_PORT=8000
PORTAL_THREADS=8

ENABLE_DEMO_DATA=False
MICROSOFT_SSO_ENABLED=False
