# Copiar como .env en el servidor Windows. No guardar contraseñas reales aquí.
SECRET_KEY=reemplazar-por-una-clave-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=portal.interno.ejemplo,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://portal.interno.ejemplo
SECURE_SSL_REDIRECT=True

DB_ENGINE=oracle
DB_DSN=servidor-oracle:1521/servicio_pdb
DB_SCHEMA=USRFACT
# Usar una sola cuenta de conexión con los GRANT del instalador.
DB_USER=C27826
DB_PASSWORD=reemplazar-por-la-contrasena-real
DB_REQUIRE_DML_ONLY=True
DB_ALLOWED_USERS=C27826,C28111,C28134
DB_CONN_MAX_AGE=60

ENABLE_DEMO_DATA=False
MICROSOFT_SSO_ENABLED=False
